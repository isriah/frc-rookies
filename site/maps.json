{
  "tiles": {
    "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors",
    "maxZoom": 18
  },
  "maps": [
    {
      "id": "everything",
      "name": "Everything",
      "title": "{season} FRC Teams and Events",
      "sources": [
        {
          "name": "Teams",
          "data": "data/all-teams.json",
          "items": "teams",
          "label": "{number} {name}",
          "details": [
            "{city}, {state}, {country}",
            "Rookie year {rookieYear}"
          ],
          "link": "https://frc-events.firstinspires.org/{season}/team/{number}",
          "noun": "teams",
          "radius": 4,
          "layers": [
            {
              "name": "Rookies ({season})",
              "color": "#f57e25",
              "where": {
                "rookieYear": "{season}"
              }
            },
            {
              "name": "Veteran teams",
              "color": "#0d6efd",
              "hidden": true
            }
          ],
          "colorBy": {
            "field": "rookieYear",
            "label": "Rookie year",
            "stops": [
              "#440154",
              "#3b528b",
              "#21918c",
              "#5ec962",
              "#fde725"
            ],
            "default": "flat"
          }
        },
        {
          "name": "Removed / not in FIRST's list",
          "data": "data/teams.json",
          "items": "teams",
          "label": "{number} {name}",
          "details": [
            "{city}, {state}, {country}",
            "{sponsors}"
          ],
          "noun": "removed teams",
          "radius": 4,
          "hidden": true,
          "layers": [
            {
              "name": "Removed / not in FIRST's list",
              "color": "#6c757d",
              "where": {
                "removed": true
              }
            }
          ]
        },
        {
          "name": "Events",
          "data": "data/event-locations.json",
          "items": "events",
          "shape": "diamond",
          "radius": 5,
          "label": "{name}",
          "details": [
            "{venue}",
            "{city}, {state}, {country}",
            "{start} to {end}"
          ],
          "link": "https://frc-events.firstinspires.org/{season}/{code}",
          "noun": "events",
          "choose": {
            "field": "season",
            "default": "{season}"
          },
          "layers": [
            {
              "name": "Season events",
              "color": "#6f42c1"
            },
            {
              "name": "Off-season events",
              "color": "#e83e8c",
              "where": {
                "type": [
                  "OffSeason",
                  "OffSeasonWithAzureSync"
                ]
              },
              "hidden": true
            }
          ]
        }
      ]
    }
  ]
}
