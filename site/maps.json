{
  "tiles": {
    "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors",
    "maxZoom": 18
  },
  "maps": [
    {
      "id": "rookies",
      "name": "Rookies",
      "title": "{season} FRC Rookie Teams",
      "data": "data/teams.json",
      "items": "teams",
      "label": "{number} {name}",
      "details": ["{city}, {state}, {country}", "{sponsors}"],
      "link": "https://frc-events.firstinspires.org/{season}/team/{number}",
      "noun": "teams",
      "layers": [
        { "name": "Rookie teams", "color": "#0d6efd", "where": { "removed": false } },
        { "name": "Removed / not in FIRST's list", "color": "#dc3545", "where": { "removed": true }, "hidden": true }
      ]
    },
    {
      "id": "all",
      "name": "All teams by rookie year",
      "title": "{season} FRC Teams by Rookie Year",
      "data": "data/all-teams.json",
      "items": "teams",
      "label": "{number} {name}",
      "details": ["{city}, {state}, {country}", "Rookie year {rookieYear}"],
      "link": "https://frc-events.firstinspires.org/{season}/team/{number}",
      "noun": "teams",
      "radius": 4,
      "layers": [{ "name": "All teams" }],
      "colorBy": {
        "field": "rookieYear",
        "label": "Rookie year",
        "stops": ["#440154", "#3b528b", "#21918c", "#5ec962", "#fde725"]
      }
    }
  ]
}
